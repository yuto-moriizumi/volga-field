{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-goal-plugin"],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "moonshotai/kimi-k2.6": {
          "options": {
            "provider": {
              "order": ["decart"],
              "allow_fallbacks": false
            }
          }
        },
        "deepseek/deepseek-v4-pro": {
          "options": {
            "provider": {
              "order": ["deepseek", "streamlake"],
              "allow_fallbacks": false
            }
          }
        },
        "minimax/minimax-m3": {
          "options": {
            "provider": {
              "order": ["minimax"],
              "allow_fallbacks": false
            }
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "bash",
          "-lc",
          "exec npx -y @playwright/mcp --headless --executable-path $(find $HOME/.cache/ms-playwright -path \"*/chrome-linux64/chrome\" -type f | sort | tail -1)"
        ]
      }
    }
  }
}
